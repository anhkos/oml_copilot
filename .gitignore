.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
node_modules/
dist/
out/
**/src/generated
syntaxes/

# Keep most generated/packaged syntaxes ignored, but allow the language package's
# manual TextMate grammar to be tracked so VS Code doesn't treat it as a generated
# (ignored) file and dim it in the explorer.
!packages/language/syntaxes/
!packages/language/syntaxes/oml.tmLanguage.json
*.tsbuildinfo
*.vsix

# Local ideas/notes
packages/language/src/mcp/IDEAS.md
packages/language/src/mcp/vision.md
packages/language/src/mcp/docs/

# experiments 
evals/

.DS_Store
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix requirement: <https://example.com/sierra/requirement#> .
@prefix stakeholder: <https://example.com/sierra/stakeholder#> .

requirement:RequirementDirectionShape
    a sh:NodeShape ;
    sh:targetClass requirement:Requirement ;
    sh:property [
        sh:path requirement:isExpressedBy ;
        sh:class stakeholder:Stakeholder ;
    ] ;
    sh:property [
        sh:path requirement:expresses ;
        sh:maxCount 0 ;
        sh:message "Use requirement:isExpressedBy on Requirement, not requirement:expresses." ;
    ] .

stakeholder:StakeholderDirectionShape
    a sh:NodeShape ;
    sh:targetClass stakeholder:Stakeholder ;
    sh:property [
        sh:path requirement:allocates ;
        sh:class requirement:Requirement ;
    ] ;
    sh:property [
        sh:path requirement:isAllocatedBy ;
        sh:maxCount 0 ;
        sh:message "Use requirement:allocates on Stakeholder, not requirement:isAllocatedBy." ;
    ] .
